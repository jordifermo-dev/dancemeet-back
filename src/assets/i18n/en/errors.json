    "isBoolean": "$t(errors.fields.{property}) must be true or false",
    "isEmail": "$t(errors.fields.{property}) must be a valid email address",
    "isMongoId": "$t(errors.fields.{property}) must be a valid identifier",
    "isArray": "$t(errors.fields.{property}) must be a list",
    "arrayMinSize": "$t(errors.fields.{property}) must have at least {constraints.0} item(s)",
    "min": "$t(errors.fields.{property}) must not be less than {constraints.0}",
    "max": "$t(errors.fields.{property}) must not be greater than {constraints.0}",
    "maxLength": "$t(errors.fields.{property}) must be at most {constraints.0} characters",
    "minLength": "$t(errors.fields.{property}) must be at least {constraints.0} characters",
    "isIn": "$t(errors.fields.{property}) is not a valid value",
    "socialUrlInstagram": "$t(errors.fields.{property}) must be an instagram.com link",
    "socialUrlFacebook": "$t(errors.fields.{property}) must be a facebook.com link",
    "socialUrlTiktok": "$t(errors.fields.{property}) must be a tiktok.com link",
    "socialUrlYoutube": "$t(errors.fields.{property}) must be a youtube.com link",
    "socialUrlWhatsapp": "$t(errors.fields.{property}) must be a wa.me or whatsapp.com link",
    "socialUrlPinterest": "$t(errors.fields.{property}) must be a pinterest.com link",
    "default": "$t(errors.fields.{property}) is invalid"
  }
